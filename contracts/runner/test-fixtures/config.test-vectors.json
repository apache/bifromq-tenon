  "invalid": [
    {
      "name": "State directory must be absolute",
      "source": "{\"stateDirectory\":\"state\",\"http\":{\"listenAddress\":\"127.0.0.1:8080\"},\"pipeline\":{\"retryBackoff\":{\"initialDelayMs\":1,\"maximumDelayMs\":1}},\"lua\":{\"cpuTimeLimitMs\":1,\"memoryLimitBytes\":1}}",
      "expectedCode": "runner_config.path_not_absolute",
      "expectedPath": "/stateDirectory"
    },
    {
      "name": "Retry maximum precedes initial delay",
      "source": "{\"stateDirectory\":\"/var/lib/tenon\",\"http\":{\"listenAddress\":\"127.0.0.1:8080\"},\"pipeline\":{\"retryBackoff\":{\"initialDelayMs\":2,\"maximumDelayMs\":1}},\"lua\":{\"cpuTimeLimitMs\":1,\"memoryLimitBytes\":1}}",
      "expectedCode": "runner_config.retry_backoff_invalid",
      "expectedPath": "/pipeline/retryBackoff"
    },
    {
      "name": "TLS certificateChainFile must be absolute",
      "source": "{\"stateDirectory\":\"/srv/tenon\",\"http\":{\"listenAddress\":\"[::1]:9090\",\"tls\":{\"certificateChainFile\":\"relative.pem\",\"privateKeyFile\":\"/etc/tenon/tls/key.pem\"}},\"pipeline\":{\"startupTimeoutMs\":45000,\"shutdownTimeoutMs\":60000,\"reconfigureTimeoutMs\":15000,\"retryBackoff\":{\"initialDelayMs\":250,\"maximumDelayMs\":10000}},\"lua\":{\"cpuTimeLimitMs\":75,\"memoryLimitBytes\":33554432}}",
      "expectedCode": "runner_config.path_not_absolute",
      "expectedPath": "/http/tls/certificateChainFile"
    },
