{
  "formatVersion": 1,
  "valid": [
    {
      "name": "Minimal JSONC configuration",
      "source": "{\n  // Runner-owned state\n  \"stateDirectory\": \"/var/lib/tenon\",\n  \"http\": {\"listenAddress\": \"127.0.0.1:8080\"},\n  \"pipeline\": {\"retryBackoff\": {\"initialDelayMs\": 100, \"maximumDelayMs\": 30000}},\n  \"lua\": {\"cpuTimeLimitMs\": 50, \"memoryLimitBytes\": 16777216}\n}",
      "expected": {
        "stateDirectory": "/var/lib/tenon",
        "httpListenAddress": "127.0.0.1:8080",
        "startupTimeoutMs": 30000,
        "shutdownTimeoutMs": 30000,
        "reconfigureTimeoutMs": 30000,
        "retryBackoffInitialDelayMs": 100,
        "retryBackoffMaximumDelayMs": 30000,
        "luaCpuTimeLimitMs": 50,
        "luaMemoryLimitBytes": 16777216
      }
    },
    {
      "name": "All optional fields",
      "source": "{\"stateDirectory\":\"/srv/tenon\",\"http\":{\"listenAddress\":\"[::1]:9090\"},\"pipeline\":{\"startupTimeoutMs\":45000,\"shutdownTimeoutMs\":60000,\"reconfigureTimeoutMs\":15000,\"retryBackoff\":{\"initialDelayMs\":250,\"maximumDelayMs\":10000}},\"lua\":{\"cpuTimeLimitMs\":75,\"memoryLimitBytes\":33554432}}",
      "expected": {
        "stateDirectory": "/srv/tenon",
        "httpListenAddress": "[::1]:9090",
        "startupTimeoutMs": 45000,
        "shutdownTimeoutMs": 60000,
        "reconfigureTimeoutMs": 15000,
        "retryBackoffInitialDelayMs": 250,
        "retryBackoffMaximumDelayMs": 10000,
        "luaCpuTimeLimitMs": 75,
        "luaMemoryLimitBytes": 33554432
      }
    },
    {
      "name": "HTTPS identity paths",
      "source": "{\"stateDirectory\":\"/srv/tenon\",\"http\":{\"listenAddress\":\"[::1]:9090\",\"tls\":{\"certificateChainFile\":\"/etc/tenon/tls/fullchain.pem\",\"privateKeyFile\":\"/etc/tenon/tls/key.pem\"}},\"pipeline\":{\"startupTimeoutMs\":45000,\"shutdownTimeoutMs\":60000,\"reconfigureTimeoutMs\":15000,\"retryBackoff\":{\"initialDelayMs\":250,\"maximumDelayMs\":10000}},\"lua\":{\"cpuTimeLimitMs\":75,\"memoryLimitBytes\":33554432}}",
      "expected": {
        "stateDirectory": "/srv/tenon",
        "httpListenAddress": "[::1]:9090",
        "startupTimeoutMs": 45000,
        "shutdownTimeoutMs": 60000,
        "reconfigureTimeoutMs": 15000,
        "retryBackoffInitialDelayMs": 250,
        "retryBackoffMaximumDelayMs": 10000,
        "luaCpuTimeLimitMs": 75,
        "luaMemoryLimitBytes": 33554432,
        "httpTls": {
          "certificateChainFile": "/etc/tenon/tls/fullchain.pem",
          "privateKeyFile": "/etc/tenon/tls/key.pem",
          "handshakeTimeoutMs": 10000
