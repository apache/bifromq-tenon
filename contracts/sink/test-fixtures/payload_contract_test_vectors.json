        {
          "name": "sink_record_payload.proto",
          "content": "syntax = \"proto3\";\n\npackage com.example.payload;\n\nimport \"helper.proto\";\n\noption java_package = \"com.example.payload\";\n\nmessage SinkRecordPayload {\n  string key = 1 [deprecated = true];\n  optional bytes value = 2;\n  PayloadMetadata metadata = 3;\n}\n"
        },
        {
          "name": "helper.proto",
          "content": "syntax = \"proto3\";\n\npackage com.example.payload;\n\nmessage PayloadMetadata {\n  uint64 timestamp = 1;\n}\n"
        }
      ],
      "entryFiles": [
        "sink_record_payload.proto"
      ],
      "expectedRootMessage": "com.example.payload.SinkRecordPayload"
    },
