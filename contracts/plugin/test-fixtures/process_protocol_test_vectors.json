  "initialActivation": [
    {
      "name": "Every Instance may still be starting when the revision is published",
      "behavior": "normal",
      "expectedInstanceStates": {
        "archive": "starting",
        "dual-a": "starting",
        "dual-b": "starting",
        "input": "starting"
      }
    },
    {
      "name": "A failed Program does not prevent complete revision publication",
      "behavior": "missing-dual-program",
      "expectedInstanceStates": {
        "archive": "starting",
        "dual-a": "start-failed",
        "dual-b": "start-failed",
        "input": "starting"
      }
    },
    {
      "name": "A complete local revision may contain only failed starts",
      "behavior": "missing-all-programs",
      "expectedInstanceStates": {
        "archive": "start-failed",
        "dual-a": "start-failed",
        "dual-b": "start-failed",
        "input": "start-failed"
      }
    }
  ],
