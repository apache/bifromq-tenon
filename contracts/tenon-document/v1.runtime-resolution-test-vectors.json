        "programCount": 2,
        "pluginInstanceCount": 2,
        "flowCount": 1
      }
    },
    {
      "name": "Lua runtime binding failure is scoped to one Flow",
      "availablePrograms": [
        {
          "programName": "com.example.device",
          "exactVersion": "1.0.0",
          "interface": "source-and-sink",
          "configSchema": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "type": "object"
          }
        }
      ],
      "document": {
        "specVersion": "1",
        "id": "lua-unready",
        "pluginInstances": {
          "device": {
            "programName": "com.example.device",
            "exactVersion": "1.0.0",
            "config": {}
          }
        },
        "flows": {
          "main": {
            "parallelism": 1,
            "source": "device",
            "process": {
              "script": "local builder = registry:getBuilder(\"com.example.undeclared@1.0.0\")\nfunction main(event) emit() end"
