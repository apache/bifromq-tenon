    {
      "name": "Instance startup arguments and environment preserve authored values",
      "document": {
        "specVersion": "1",
        "id": "startup-settings",
        "pluginInstances": {
          "source": {
            "programName": "com.example.source",
            "exactVersion": "1.0.0",
            "extraArgs": {"args": ["a b", "", "$HOME"], "position": "prepend"},
            "env": {"APP_REGION": "cn-north", "EMPTY": ""},
            "config": {}
          },
          "sink": {
            "programName": "com.example.sink",
            "exactVersion": "1.0.0",
            "config": {}
          }
        },
        "flows": {
          "main": {"source": "source", "process": {"script": "function main(event) emit() end"}, "sinks": ["sink"]}
        }
      }
    },
    {
      "name": "One directed Flow with separate Plugin Instances",
      "document": {
        "specVersion": "1",
        "id": "factory-uplink",
        "pluginInstances": {
          "device": {
            "programName": "com.example.modbus",
            "exactVersion": "1.0.0",
            "config": {}
          },
          "cloud": {
            "programName": "com.example.kafka",
            "exactVersion": "1.0.0",
            "config": {}
          }
        },
        "flows": {
          "telemetry": {
            "parallelism": 1,
            "source": "device",
            "process": {
              "script": "function main(event) emit() end"
            },
            "sinks": [
              "cloud"
            ]
          }
        }
      }
    },
    {
      "name": "Dual-interface Instance can feed its own Sink interface",
      "document": {
        "specVersion": "1",
