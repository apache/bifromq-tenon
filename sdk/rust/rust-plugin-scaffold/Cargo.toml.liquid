[package]
name = "{{ project-name }}"
version = "0.1.0"
edition = "2024"
rust-version = "1.99.0"
license = "Apache-2.0"
publish = false

[package.metadata.tenon]
display-name = "{{ project-name }}"
description = "Example Tenon {{ interface }} plugin."
program-name = "com.example.{{ project-name | replace: "_", "-" | downcase }}"
interface = "{{ interface }}"

[dependencies]
tenon-plugin-sdk = "=0.1.0"

[build-dependencies]
prost-build = "=0.14.4"
protoc-bin-vendored = "=3.2.0"
{% if interface != "source" %}
[dev-dependencies]
tempfile = "=3.27.0"
{% endif %}
