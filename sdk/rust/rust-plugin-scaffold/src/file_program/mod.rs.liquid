//! Owns this program's business resources for one SDK-managed lifetime.

use crate::{output::Output, payload::SinkRecordPayload};
{% if interface == "source-and-sink" %}use crate::{payload::SourceRecordPayload, source::Source};
use std::collections::BTreeSet;
use std::sync::Mutex;
{% endif %}use std::{future::ready, path::Path};
{% if interface == "sink" %}use tenon_plugin_sdk::TenonSink;
{% endif %}use tenon_plugin_sdk::{Error, FlowChannel, Value};
{% if interface == "source-and-sink" %}use tenon_plugin_sdk::{Ingress, TenonSource, TenonSourceAndSink};
{% endif %}
pub(super) struct FileProgram {
{% if interface == "source-and-sink" %}    output: Option<Output>,
    source: Mutex<Option<Source>>,
{% else %}    output: Output,
{% endif %}}

impl FileProgram {
{% if interface == "source-and-sink" %}    pub(super) fn new(
        config: Value,
        ingress: Option<Ingress<SourceRecordPayload>>,
        channels: BTreeSet<FlowChannel>,
    ) -> Result<Self, Error> {
        let output = if channels.is_empty() {
            None
        } else {
            let path = config["outputFile"].as_str().ok_or_else(|| {
                std::io::Error::other("outputFile is required when Sink is bound")
            })?;
            Some(Output::open(Path::new(path))?)
        };
        let source = ingress
            .map(|Ingress { sender, .. }| Source::new(&config, sender))
            .transpose()?;
        Ok(Self {
            output,
            source: Mutex::new(source),
        })
{% else %}    pub(super) fn new(config: Value) -> Result<Self, Error> {
        let path = config["outputFile"]
            .as_str()
            .expect("config.schema.json requires an absolute output path");
        Ok(Self {
            output: Output::open(Path::new(path))?,
        })
{% endif %}    }
}

{% if interface == "source-and-sink" %}impl TenonSourceAndSink<SinkRecordPayload> for FileProgram {
    fn start(&mut self) {
        if let Some(source) = self
            .source
            .get_mut()
            .expect("Source lock must not panic")
            .as_mut()
        {
            source.start();
        }
    }

    fn quiesce(&self) {
        if let Some(source) = self
            .source
            .lock()
            .expect("Source lock must not panic")
            .as_mut()
        {
            source.quiesce();
        }
    }
{% else %}impl TenonSink<SinkRecordPayload> for FileProgram {
    fn start(&mut self) {}
{% endif %}
    fn write(
        &self,
        _channel: FlowChannel,
        records: Box<[SinkRecordPayload]>,
    ) -> impl Future<Output = Result<(), Error>> {
{% if interface == "source-and-sink" %}        ready(match &self.output {
            Some(output) => output.write(&records),
            None => Err(std::io::Error::other("Sink direction is not bound").into()),
        })
{% else %}        ready(self.output.write(&records))
{% endif %}    }

    fn close(&mut self) {
{% if interface == "source-and-sink" %}        if let Some(source) = self
            .source
            .get_mut()
            .expect("Source lock must not panic")
            .as_mut()
        {
            source.close();
        }
{% endif %}        // Every successful batch is already durable; dropping this owner closes the file.
    }
}
