//! The explicit entrypoint for this Plugin's declared interface.

{% if interface != "source" %}mod file_program;
mod output;
{% endif %}mod payload;
{% if interface != "sink" %}mod source;
{% endif %}
{% if interface == "source" %}use tenon_plugin_sdk::SourceProgram;

fn main() {
    let program =
        SourceProgram::run(|config, _parallelism, sender| source::Source::new(&config, sender));
    program.await_shutdown();
}
{% elsif interface == "sink" %}use tenon_plugin_sdk::SinkProgram;

fn main() {
    let program = SinkProgram::run(file_program::FileProgram::new);
    program.await_shutdown();
}
{% else %}use tenon_plugin_sdk::SourceAndSinkProgram;

fn main() {
    let program = SourceAndSinkProgram::run(|config, ingress, channels| {
        file_program::FileProgram::new(config, ingress, channels)
    });
    program.await_shutdown();
}
{% endif -%}
