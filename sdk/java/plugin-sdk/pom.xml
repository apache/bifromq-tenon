<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.apache.bifromq.tenon</groupId>
        <artifactId>tenon-java-build</artifactId>
        <version>0.1.0</version>
    </parent>

    <artifactId>tenon-plugin-sdk</artifactId>
    <name>Tenon Plugin SDK</name>

    <dependencies>
        <dependency>
            <groupId>org.apache.bifromq.tenon</groupId>
            <artifactId>tenon-process-metrics</artifactId>
        </dependency>
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-sdk-metrics</artifactId>
        </dependency>
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-exporter-otlp-common</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.bifromq.tenon</groupId>
            <artifactId>tenon-ipc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.bifromq.tenon</groupId>
            <artifactId>tenon-ipc</artifactId>
            <classifier>tests</classifier>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.google.protobuf</groupId>
            <artifactId>protobuf-java</artifactId>
        </dependency>
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-netty-shaded</artifactId>
        </dependency>
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-protobuf</artifactId>
        </dependency>
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-stub</artifactId>
        </dependency>
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>${maven.shade.plugin.version}</version>
                <executions>
                    <execution>
                        <id>embed-internal-runtime</id>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <artifactSet>
                                <includes>
                                    <include>org.apache.bifromq.tenon:tenon-ipc</include>
                                    <include>io.opentelemetry:*</include>
                                </includes>
                            </artifactSet>
                            <relocations>
                                <relocation>
                                    <pattern>io.opentelemetry</pattern>
                                    <shadedPattern>org.apache.bifromq.tenon.sdk.internal.otel</shadedPattern>
                                </relocation>
                            </relocations>
                            <filters>
                                <filter>
                                    <artifact>org.apache.bifromq.tenon:tenon-ipc</artifact>
                                    <excludes>
                                        <exclude>META-INF/MANIFEST.MF</exclude>
                                        <exclude>META-INF/LICENSE</exclude>
                                        <exclude>META-INF/NOTICE</exclude>
                                        <exclude>META-INF/DISCLAIMER</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <createDependencyReducedPom>true</createDependencyReducedPom>
                            <useDependencyReducedPomInJar>true</useDependencyReducedPomInJar>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>flatten-consumer-pom</id>
                        <phase>verify</phase>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>io.github.ascopes</groupId>
                <artifactId>protobuf-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>generate-plugin-contracts</id>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
                            <sourceDirectories>
                                <sourceDirectory>
                                    ${maven.multiModuleProjectDirectory}/../../contracts/plugin
                                </sourceDirectory>
                                <sourceDirectory>
                                    ${maven.multiModuleProjectDirectory}/../../contracts/source
                                </sourceDirectory>
                                <sourceDirectory>
                                    ${maven.multiModuleProjectDirectory}/../../contracts/sink
                                </sourceDirectory>
                            </sourceDirectories>
                            <includes>
                                <include>process_control.proto</include>
                                <include>process_metrics.proto</include>
                                <include>ingress_record.proto</include>
                                <include>egress_record.proto</include>
                            </includes>
                            <plugins>
                                <plugin kind="binary-maven">
                                    <groupId>io.grpc</groupId>
                                    <artifactId>protoc-gen-grpc-java</artifactId>
                                    <version>${grpc.version}</version>
                                </plugin>
                            </plugins>
                        </configuration>
                    </execution>
                    <execution>
                        <id>generate-test-payload-contract</id>
                        <goals>
                            <goal>generate-test</goal>
                        </goals>
                        <configuration>
                            <sourceDirectories>
                                <sourceDirectory>
                                    ${maven.multiModuleProjectDirectory}/../../contracts/sink/test-fixtures
                                </sourceDirectory>
                            </sourceDirectories>
                            <includes>
                                <include>sink_record_payload.proto</include>
                            </includes>
                            <outputDirectory>
                                ${project.build.directory}/generated-test-sources/protobuf
                            </outputDirectory>
                            <incrementalCompilation>false</incrementalCompilation>
                            <outputDescriptorFile>
                                ${project.build.directory}/contract-fixture/payload.descriptor.pb
                            </outputDescriptorFile>
                            <outputDescriptorIncludeImports>true</outputDescriptorIncludeImports>
                            <outputDescriptorIncludeSourceInfo>
                                true
                            </outputDescriptorIncludeSourceInfo>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <version>${build.helper.maven.plugin.version}</version>
                <executions>
                    <execution>
                        <id>register-generated-test-sources</id>
                        <phase>generate-test-sources</phase>
                        <goals>
                            <goal>add-test-source</goal>
                        </goals>
                        <configuration>
                            <sources>
                                <source>
                                    ${project.build.directory}/generated-test-sources/protobuf
                                </source>
                            </sources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <tenon.test.payload.descriptor>
                            ${project.build.directory}/contract-fixture/payload.descriptor.pb
                        </tenon.test.payload.descriptor>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
